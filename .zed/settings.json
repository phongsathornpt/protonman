{
  "lsp": {
    "gopls": {
      "initialization_options": {
        "buildFlags": ["-tags=desktop"]
      }
    }
  },
  "languages": {
    "Go": {
      "language_servers": ["gopls"],
      "formatter": "language_server",
      "format_on_save": "on"
    },
    "TypeScript": {
      "formatter": "language_server",
      "format_on_save": "on"
    },
    "TSX": {
      "formatter": "language_server",
      "format_on_save": "on"
    }
  },
  "file_scan_exclusions": [
    "**/node_modules",
    "**/dist",
    "**/tsconfig.tsbuildinfo"
  ]
}
